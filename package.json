{
  "name": "billboardos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:convex": "convex dev",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit && tsc -p convex --noEmit && tsc -p server --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "convex run seed:demo",
    "buyer": "tsx server/buyer-agent.ts",
    "postinstall": "node -e \"require('fs').cpSync('node_modules/@mediapipe/tasks-vision/wasm','public/mediapipe',{recursive:true})\"",
    "webhook:listen": "tsx server/webhook-receiver.ts",
    "a2a:demo": "tsx server/a2a-demo.ts",
    "creao:run": "node --env-file-if-exists=.env server/creao-first-run.mjs",
    "creao:rehearsal": "node server/creao-rehearsal.mjs",
    "deploy:web": "npx @convex-dev/static-hosting upload --build",
    "deploy:prod": "npx @convex-dev/static-hosting deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@auth/core": "^0.41.1",
    "@coinbase/cdp-sdk": "^1.60.0",
    "@convex-dev/auth": "^0.0.96",
    "@convex-dev/static-hosting": "^0.2.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@x402/core": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "@x402/express": "^2.28.0",
    "@x402/extensions": "^2.28.0",
    "@x402/fetch": "^2.28.0",
    "@x402/svm": "^2.28.0",
    "convex": "^1.48.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "convex-test": "^0.0.65",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
