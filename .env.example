# BillboardOS environment template
# Copy to .env and fill in. Never commit .env or paste real values into issues or screenshots.
#
# Where each value is read:
#   [local]  read from .env by the Express x402 server, buyer agent, edge counter or scripts
#   [convex] read inside Convex functions. Convex does NOT read this file; push these with
#            `npx convex env set NAME value` (or the dashboard). Keeping them here is just one
#            place to copy from.
#   [web]    exposed to the browser (VITE_ prefix). Never put a secret here.

# ---------------------------------------------------------------------------
# Convex
# `npx convex dev` writes CONVEX_DEPLOYMENT and VITE_CONVEX_URL to .env.local automatically.
# ---------------------------------------------------------------------------
CONVEX_DEPLOYMENT=                                # [local] e.g. dev:happy-animal-123
VITE_CONVEX_URL=https://lovable-cricket-727.convex.cloud # [web] public shared demo deployment; optional override
CONVEX_URL=                                       # [local] same URL, used by the Express server's Convex client
CONVEX_SITE_URL=                                  # [local] https://<deployment>.convex.site (HTTP actions, webhooks)
INTERNAL_API_SECRET=                              # [local][convex] shared secret so the Express server and edge
                                                  #   device can call protected Convex endpoints; generate with
                                                  #   `openssl rand -hex 32`

# ---------------------------------------------------------------------------
# Coinbase CDP + x402 (Payment Agents track) — portal.cdp.coinbase.com
# Testnet only: Base Sepolia, faucet USDC.
# ---------------------------------------------------------------------------
CDP_API_KEY_ID=                                   # [convex][local] authenticates to the CDP facilitator and wallets
CDP_API_KEY_SECRET=                               # [convex][local]
CDP_WALLET_SECRET=                                # [convex][local] needed for CDP-managed wallets (buyer, optional seller)
X402_PAY_TO=                                      # [convex] receiving address (0x...) on Base Sepolia; for the live auction leave empty or use the operator account (npx convex run companyAgentsNode:operatorWallet)
X402_NETWORK=eip155:84532                         # [local] Base Sepolia; mainnet would be eip155:8453 (don't)
X402_ENVIRONMENT=development                      # [local] development = testnets and test funds
X402_SERVER_URL=                                  # [local] optional override for scripts; payments run on Convex at CONVEX_SITE_URL by default
X402_RECEIVER_WALLET_NAME=billboardos-operator    # [convex] CDP wallet created as the receiver when X402_PAY_TO is empty
X402_REPORT_PRICE_USD=0.05                        # [convex] price of a seller agent's audience report

# Company agents (the live auction) need no keys here: each company's agent runs on Convex with its
# own CDP wallet, set up from #/customer/agent. The settings below are developer tools only, outside
# the demo path: `npm run buyer` and `npm run a2a:demo` (real x402 from a laptop).
BUYER_WALLET_NAME=advertiser-agent-1              # [local] developer tool: CDP account name for the buyer wallet
BUYER_MAX_BUDGET_USDC=100                         # [local] developer tool: hard spend cap the buyer agent can't exceed
# Agent keys: issued from the customer dashboard, or for the developer tools by `npx convex run seed:demoAgentKeys`
BUYER_AGENT_KEY=                                  # [local] developer tool: bos_agent_... used by `npm run buyer`
AUCTION_NVIDIA_AGENT_KEY=                         # [local] developer tool: Nvidia key for `npm run a2a:demo`
AUCTION_NVIDIA_WALLET=                            # [local] developer tool: CDP wallet name for `npm run a2a:demo` (defaults to BUYER_WALLET_NAME)
WEBHOOK_SECRET=                                   # [local] secret printed by seed:demoWatchRules, used by `npm run webhook:listen`
COMPANY_AGENT_DELAY_MS=                           # [convex] TESTS ONLY: set to 0 to remove the company agents' random bid delay. Never set in production

# ---------------------------------------------------------------------------
# Anthropic — console.anthropic.com
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=                                # [convex][local]
ANTHROPIC_MODEL=claude-opus-5-5                   # [convex][local]

# ---------------------------------------------------------------------------
# CREAO (Best One-Person Company) — agent.creao.ai via the hackathon sign-up link
# The shared app calls CREAO through Convex actions. Set the [convex] values once
# on the shared deployment; teammates do not need these credentials in local .env.
# The local CLI smoke test can still use the [local] key values below.
# ---------------------------------------------------------------------------
CREAO_API_KEY=                                    # [local] optional account capi_ key for npm run creao:run only
CREAO_API_BASE_URL=https://agent.creao.ai          # [convex] official API Trigger origin
CREAO_SALES_AGENT_ID=                             # [convex] saved BillboardOS Sales Agent UUID
CREAO_SALES_API_KEY=                              # [convex] Sales app-scoped capi_ key; server-side only
CREAO_REVENUE_AGENT_ID=                           # [convex] saved BillboardOS Revenue Agent UUID
CREAO_REVENUE_API_KEY=                            # [convex] Revenue app-scoped capi_ key; server-side only
CREAO_PROSPECTOR_AGENT_ID=                        # [convex] agent IDs are shown on each agent's page
CREAO_PROPOSAL_AGENT_ID=                          # [convex]
CREAO_COLLECTIONS_AGENT_ID=                       # [convex]
# Shared integration polls GET /api/v1/apps/<id>/runs/<runId> from Convex actions.
# npm run creao:run reads local CREAO_API_KEY or local role-specific keys from .env.
# CREAO webhooks are unsigned; verify completion by authenticated GET, not a made-up shared secret.

# ---------------------------------------------------------------------------
# CRS Credit API sandbox — calhacks.crscreditapi.com (credentials arrive by email)
# Use only the provided test identities.
# ---------------------------------------------------------------------------
CRS_API_BASE_URL=https://api-sandbox.stitchcredit.com:443/api   # [convex]
CRS_USERNAME=                                     # [convex] for POST /users/login → Bearer token
CRS_PASSWORD=                                     # [convex]

# ---------------------------------------------------------------------------
# Capital One Nessie (simulated bank) — nessieisreal.com
# ---------------------------------------------------------------------------
NESSIE_API_BASE_URL=https://api.nessieisreal.com  # [convex] HTTPS only; plain HTTP times out
NESSIE_API_KEY=                                   # [convex]
NESSIE_OPERATOR_ACCOUNT_ID=                       # [convex] the operator's bank account that receives invoice payments

# ---------------------------------------------------------------------------
# Edge device: camera counter + billboard player
# ---------------------------------------------------------------------------
BILLBOARD_ID=                                     # [local] Convex _id of the billboard this device represents
CAMERA_DEVICE_ID=0                                # [local] OpenCV/browser camera index
COUNT_INTERVAL_SECONDS=10                         # [local] how often aggregate counts are posted
SIMULATE_AUDIENCE=false                           # [local] true = synthetic counts; the UI must label them simulated

# ---------------------------------------------------------------------------
# P2 — only if we build these
# ---------------------------------------------------------------------------
AGENTVERSE_API_KEY=                               # [local] Fetch.ai Agentverse
FETCH_AGENT_SEED=                                 # [local] uAgents seed phrase; determines the agent address
APIFY_API_TOKEN=                                  # [convex] public local-events actor
